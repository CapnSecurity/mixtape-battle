{
  "name": "mixtape-battle",
  "version": "0.3.8",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:full": "node ./scripts/dev-full.js",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:prod": "sh scripts/start.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:scan": "npm run security:audit"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^4.16.2",
    "@tailwindcss/postcss": "^4.3.5",
    "bcryptjs": "^3.0.3",
    "isomorphic-dompurify": "^2.35.0",
    "next": "^15.5.29",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.5.0",
    "prisma": "4.16.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "25.2.2",
    "@types/react": "19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "pg": "^8.23.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "next": {
      "postcss": "$postcss"
    }
  }
}
