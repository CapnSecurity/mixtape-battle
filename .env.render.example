# Environment Variables for Render Deployment
# Copy these to Render Dashboard → Web Service → Environment

# ===========================================
# DATABASE (from Render PostgreSQL)
# ===========================================
DATABASE_URL=<RENDER_POSTGRES_INTERNAL_URL>
# Example: postgresql://user:password@dpg-xxxxx-a.oregon-postgres.render.com/dbname

# ===========================================
# NEXTAUTH CONFIGURATION
# ===========================================
NEXTAUTH_URL=https://themixtape.me
NEXTAUTH_SECRET=<KEEP_YOUR_EXISTING_SECRET_OR_GENERATE_NEW>
# Generate new: openssl rand -base64 32

NEXTAUTH_CSRF_TOKEN_SECRET=<KEEP_YOUR_EXISTING_SECRET_OR_GENERATE_NEW>
# Generate new: openssl rand -base64 32

# ===========================================
# EMAIL CONFIGURATION (Zoho SMTP)
# ===========================================
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=admin@themixtape.me
SMTP_PASSWORD=<YOUR_ZOHO_PASSWORD>
SMTP_FROM=admin@themixtape.me

# ===========================================
# API KEYS
# ===========================================
LASTFM_API_KEY=<YOUR_NEW_LASTFM_KEY>
# Last.fm: the key that used to be hardcoded in lib/lastfm.ts is in git history; revoke it at
# https://www.last.fm/api/accounts and use the new key above. Lookups are skipped if unset.

# ===========================================
# ACCESS CONTROL / PROXY (new)
# ===========================================
# Public sign-up is OFF unless this is exactly "true". New accounts come from admin invites.
# ALLOW_PUBLIC_SIGNUP=true
# Number of trusted proxies appending to X-Forwarded-For (used by rate limiting). Default 1
# (right-most entry). Verify the real Cloudflare + Render chain before raising it (likely 2).
# TRUSTED_PROXY_HOPS=1
# Verbose diagnostics (non-secret) in production; leave unset normally.
# LOG_LEVEL=debug

# ===========================================
# OPTIONAL/ADVANCED
# ===========================================
NODE_ENV=production

# ===========================================
# CURRENT PRODUCTION VALUES TO MIGRATE
# ===========================================
# Run this command to see your current production values:
# docker exec mixtape-app env | grep -E "NEXTAUTH_SECRET|NEXTAUTH_CSRF|LASTFM"
